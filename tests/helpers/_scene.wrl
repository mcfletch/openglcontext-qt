#VRML V2.0 utf8
# A scene for the Qt demo's tests: small, self-contained, and named, so the
# tree the demo builds from it has something recognisable in it.
DEF hub Transform {
  children [
    DEF thing Shape {
      appearance Appearance {
        material Material { diffuseColor 0.8 0.3 0.2 }
      }
      geometry Box { size 2 2 2 }
    }
    DEF lamp PointLight {
      location 4 4 4
    }
  ]
}
